<resources>
    <!-- Base application theme -->
    <style name="Theme.MyFirstApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Common attributes for both light and dark themes -->
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariantLight</item>
        <item name="colorSecondary">@color/colorSecondaryLight</item>
    </style>

    <!-- Light Theme -->
    <style name="Theme.MyFirstApp.Light" parent="Theme.MyFirstApp">
        <item name="colorPrimary">@color/colorPrimaryLight</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariantLight</item>
        <item name="colorSecondary">@color/colorSecondaryLight</item>
        <item name="android:colorBackground">@color/backgroundLight</item>
        <item name="android:textColor">@color/textColorLight</item> <!-- Light mode text color -->
        <item name="colorButtonNormal">@color/buttonBackgroundLight</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.MyFirstApp.Dark" parent="Theme.MyFirstApp">
        <item name="colorPrimary">@color/colorPrimaryDark</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryVariantDark</item>
        <item name="colorSecondary">@color/colorSecondaryDark</item>
        <item name="android:colorBackground">@color/backgroundDark</item>
        <item name="android:textColor">@color/textColorDark</item> <!-- Dark mode text color -->
        <item name="colorButtonNormal">@color/buttonBackgroundDark</item>
    </style>
</resources>
